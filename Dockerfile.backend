FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ .

RUN mkdir -p /var/lib/monitocam/recordings /var/lib/monitocam/staticfiles

RUN useradd -m -u 1001 appuser && chown -R appuser:appuser /app /var/lib/monitocam
USER appuser

EXPOSE 8585

ENTRYPOINT ["sh", "entrypoint.sh"]
CMD ["uvicorn", "config.asgi:application", "--host", "0.0.0.0", "--port", "8585", "--workers", "2"]
